# Access control for the UI and API. Rules run as trusted code (node:vm is not
# a sandbox), so this is the real gate. REQUIRED — the worker refuses to start
# without it. Generate one with e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=

# Host port for docker compose.
PORT=8787

# Override the bind address (defaults to 0.0.0.0). Max wall-clock per rule run
# in ms (default 10000).
# HOST=0.0.0.0
# RULE_TIMEOUT_MS=10000

# Optional Decisions classification alongside existing Autopilot delivery (shadow only).
# Off by default. Enabling sends bounded, redacted completion text to OpenAI;
# it records candidates only and never skips an agent or handles an alert.
# AUTOPILOT_DECISIONS_SHADOW=true
# AUTOPILOT_DECISIONS_API_KEY=

# Active routing also needs input.routing on each Autopilot Routine.
# AUTOPILOT_DECISIONS_ACTIVE=false

# Optional override for the authenticated AP reconciliation API.
# Without it, the API follows AUTOPILOT_DECISIONS_ACTIVE for compatibility.
# AUTOPILOT_PERIODIC_RECONCILE=true
# AUTOPILOT_GITHUB_RESERVE=1500

# Autopilot triage: off (default), shadow (record decisions only) or active.
# AUTOPILOT_TRIAGE=shadow
