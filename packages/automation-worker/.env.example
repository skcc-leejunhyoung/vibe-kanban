# Access control for the UI and API. Rules run as trusted code (node:vm is not
# a sandbox), so this is the real gate. REQUIRED — the worker refuses to start
# without it. Generate one with e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=

# Host port for docker compose.
PORT=8787

# Override the bind address (defaults to 0.0.0.0). Max wall-clock per rule run
# in ms (default 10000).
# HOST=0.0.0.0
# RULE_TIMEOUT_MS=10000
