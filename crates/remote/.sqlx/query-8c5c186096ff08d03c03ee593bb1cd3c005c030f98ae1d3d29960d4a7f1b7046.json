  "query": "\n            UPDATE hosts\n            SET custom_name = $3,\n                updated_at = NOW()\n            WHERE id = $1 AND owner_user_id = $2\n            RETURNING\n                id,\n                owner_user_id,\n                machine_id AS \"machine_id!\",\n                COALESCE(custom_name, name) AS \"name!\",\n                status,\n                last_seen_at,\n                agent_version,\n                created_at,\n                updated_at,\n                'owner' AS \"access_role!\"\n            ",
